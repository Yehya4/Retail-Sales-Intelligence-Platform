# ============================================================
# Retail & Sales Intelligence Platform — Environment Variables
# Copier ce fichier en ".env" et remplir les valeurs réelles.
# NE JAMAIS committer le fichier .env sur GitHub.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_dw
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# --- Chemins des données ---
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_REJECTED_PATH=data/rejected
LOGS_PATH=logs

# --- PySpark ---
SPARK_MASTER=local[*]
SPARK_APP_NAME=RetailSalesIntelligence
SPARK_DRIVER_MEMORY=4g

# --- Pipeline ---
PIPELINE_BATCH_SIZE=100000
PIPELINE_LOG_LEVEL=INFO

# --- Kaggle (optionnel, pour téléchargement automatique) ---
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
